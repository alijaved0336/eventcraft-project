FROM node:20-alpine
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Install dependencies first (layer cache)
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install

# Copy source (overridden by volume in docker-compose)
COPY . .

EXPOSE 4000
CMD ["pnpm", "dev"]
