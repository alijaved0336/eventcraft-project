# ═══════════════════════════════════════════════════════════════
# EventCraft API — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env for local development:
#   cp .env.example .env
# For production, see .env.production as a reference
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ────────────────────────────────────────────────
# Local: mongodb://localhost:27017/eventcraft
# Docker: mongodb://mongo:27017/eventcraft?replicaSet=rs0
# Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/eventcraft
MONGO_URI=mongodb://localhost:27017/eventcraft

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=replace-with-min-32-char-random-string
JWT_REFRESH_SECRET=replace-with-different-min-32-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
OAUTH_CALLBACK_BASE=http://localhost:4000/api

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ═══════════════════════════════════════════════════════════════
# FUTURE SERVICES — uncomment when implementing
# ═══════════════════════════════════════════════════════════════

# ── AWS S3 + CloudFront ──────────────────────────────────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# S3_BUCKET_NAME=eventcraft-assets-dev
# CLOUDFRONT_DOMAIN=xxxxxxxxxxxx.cloudfront.net

# ── Stripe ───────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── SendGrid ─────────────────────────────────────────────────
# SENDGRID_API_KEY=SG.replace_me
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ── Twilio ───────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=replace_me
# TWILIO_FROM_NUMBER=+1234567890

# ── AI Service ───────────────────────────────────────────────
# AI_SERVICE_URL=http://localhost:8000
