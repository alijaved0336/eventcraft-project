{
  "version": 2,
  "routes": [
    {
      "src": "/graphql",
      "dest": "api/index.ts",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "regions": ["bom1"]
}


