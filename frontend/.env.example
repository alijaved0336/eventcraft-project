# ── API ──────────────────────────────────────────────────────
# URL of the EventCraft backend (for Vite proxy in dev,
# and direct in production build)
VITE_API_URL=http://localhost:4000/
# VITE_API_URL=https://eventcraftapi.vercel.app/

# ── WebSocket ─────────────────────────────────────────────────
# Used for GraphQL subscriptions via Apollo Client
VITE_WS_URL=ws://localhost:4000/
# VITE_WS_URL=ws://eventcraftapi.vercel.app/

# ── App ───────────────────────────────────────────────────────
VITE_APP_NAME=EventCraft
VITE_ENVIRONMENT=development

# ── Payments ──────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
